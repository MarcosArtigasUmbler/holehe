# Porta exposta no host
PORT=8000
# Se definido, todo request a /check e /modules exige header X-API-Key com este valor
API_KEY=
# Quantos scans simultâneos o serviço aceita (cada scan abre ~120 conexões)
MAX_CONCURRENT_SCANS=4
# Timeout por site, em segundos
HOLEHE_TIMEOUT=10
# Quantos sites verificar em paralelo dentro de um scan
HOLEHE_MODULE_CONCURRENCY=50

# --- GHunt (enriquecimento de conta Google, útil para @gmail.com) ---
# Liga/desliga a integração
GHUNT_ENABLED=true
# Timeout das chamadas ao Google, em segundos
GHUNT_TIMEOUT=20
# Sessão do GHunt: conteúdo do arquivo creds.m (base64), gerado uma vez com `ghunt login`.
# Sem isso, o bloco "google" volta com enabled=false e o /check continua funcionando.
GHUNT_CREDS_B64=
# Caminho do arquivo de credenciais dentro do container (default abaixo)
GHUNT_CREDS_PATH=/home/api/.malfrats/ghunt/creds.m
