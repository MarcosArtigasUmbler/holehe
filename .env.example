# Porta exposta no host
PORT=8000
# Se definido, todo request a /check e /modules exige header X-API-Key com este valor
API_KEY=
# Quantos scans simultâneos o serviço aceita (cada scan abre ~120 conexões)
MAX_CONCURRENT_SCANS=4
# Timeout por site, em segundos
HOLEHE_TIMEOUT=10
# Quantos sites verificar em paralelo dentro de um scan
HOLEHE_MODULE_CONCURRENCY=50
